{
  "manifest_version": 3,
  "name": "Signal Intelligence",
  "version": "0.11.0",
  "description": "Track and compare India phone prices on Flipkart, Amazon.in, mi.com and vivo, plus public news and YouTube comments on the models.",
  "action": {
    "default_title": "Signal Intelligence",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "optional_host_permissions": [
    "https://news.google.com/*",
    "https://www.reddit.com/*",
    "https://www.smartprix.com/*",
    "https://www.googleapis.com/*",
    "https://www.flipkart.com/*",
    "https://www.amazon.in/*",
    "https://www.mi.com/*",
    "https://shop.vivo.com/*",
    "https://*/*"
  ]
}
